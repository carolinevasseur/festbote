  <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Lora:ital,wght@0,400;0,500;1,400&family=Archivo:wght@300;400;500&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --red: #BD3F3F; --red-dark: #9e3333;
      --bg: #F8F2F1; --accent: #D1B099;
      --olive: #7A745F; --dark: #2C312D; --white: #fff;
