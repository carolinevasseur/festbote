    .nav-cta:hover { background: var(--red-dark) !important; }

    .page { display: none; padding-top: 100px; }
    .page.active { display: block; }

    .hero {
      min-height: calc(100vh - 100px);
      display: grid; grid-template-columns: 1fr 1fr;
      align-items: center; gap: 60px; padding: 80px 8%;
      position: relative; overflow: hidden;
    }
    .hero::after {
      content: ''; position: absolute; top: -80px; right: -80px;
      width: 480px; height: 480px;
      background: radial-gradient(circle, rgba(209,176,153,0.18) 0%, transparent 70%);
      pointer-events: none;
    }
    .hero-badge { display: inline-block; font-size: 11px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--red); background: rgba(189,63,63,0.09); padding: 5px 14px; border-radius: 2px; margin-bottom: 22px; }
    .hero h1 { font-family: 'Archivo Black', sans-serif; font-size: clamp(38px, 4.5vw, 62px); line-height: 1.1; color: var(--dark); margin-bottom: 22px; letter-spacing: -0.02em; }
    .hero h1 em { color: var(--red); font-style: normal; }
    .hero-sub { font-family: 'Lora', serif; font-size: 18px; color: var(--olive); margin-bottom: 38px; max-width: 460px; line-height: 1.8; }
    .hero-btns { display: flex; gap: 14px; flex-wrap: wrap; }
    .btn { display: inline-block; padding: 15px 30px; font-size: 13px; font-weight: 500; letter-spacing: 0.07em; text-transform: uppercase; border-radius: 2px; text-decoration: none; transition: all 0.2s; cursor: pointer; border: none; }
    .btn-primary { background: var(--red); color: var(--white); }
    .btn-primary:hover { background: var(--red-dark); transform: translateY(-2px); }
    .btn-outline { background: transparent; color: var(--dark); border: 1.5px solid var(--accent); }
    .btn-outline:hover { border-color: var(--dark); }
    .hero-visual { display: flex; align-items: center; justify-content: center; position: relative; }
    .hero-img-wrap { width: 100%; max-width: 460px; background: rgba(209,176,153,0.12); border-radius: 4px; aspect-ratio: 1; display: flex; align-items: center; justify-content: center; border: 1px solid rgba(209,176,153,0.25); overflow: hidden; }
    .hero-img-wrap img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .hero-float { position: absolute; bottom: -20px; left: -20px; background: var(--white); border-radius: 4px; padding: 14px 20px; box-shadow: 0 8px 30px rgba(44,49,45,0.10); display: flex; align-items: center; gap: 12px; }
    .hero-float-icon { font-size: 28px; }
    .hero-float-text { font-size: 13px; color: var(--olive); line-height: 1.4; }
    .hero-float-text strong { display: block; color: var(--dark); font-size: 15px; }

    .trust-bar { background: var(--dark); padding: 18px 8%; display: flex; align-items: center; justify-content: center; gap: 48px; flex-wrap: wrap; }
    .trust-item { display: flex; align-items: center; gap: 10px; color: rgba(248,242,241,0.7); font-size: 13px; letter-spacing: 0.04em; }
    .trust-item span { font-size: 18px; }

    section { padding: 96px 8%; }
    .section-label { font-size: 14px; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; color: var(--red); margin-bottom: 14px; }
    .section-title { font-family: 'Archivo Black', sans-serif; font-size: clamp(28px, 3vw, 44px); line-height: 1.15; color: var(--dark); margin-bottom: 20px; letter-spacing: -0.01em; }
    .section-title em { color: var(--red); font-style: normal; }
    .section-sub { font-family: 'Lora', serif; font-size: 17px; color: var(--olive); max-width: 560px; line-height: 1.8; }

    .how { background: var(--white); }
    .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; margin-top: 56px; }
    .step { padding: 40px 32px; border: 1px solid rgba(209,176,153,0.3); border-radius: 4px; transition: box-shadow 0.2s, transform 0.2s; background: var(--bg); text-align: center; }
    .step:hover { box-shadow: 0 8px 32px rgba(44,49,45,0.08); transform: translateY(-3px); }
    .step-icon-wrap { width: 64px; height: 64px; border-radius: 50%; background: rgba(189,63,63,0.10); display: flex; align-items: center; justify-content: center; font-size: 28px; margin: 0 auto 20px; }
    .step-num { font-family: 'Archivo Black', sans-serif; font-size: 11px; letter-spacing: 0.15em; text-transform: uppercase; color: var(--red); margin-bottom: 12px; }
    .step h3 { font-family: 'Archivo Black', sans-serif; font-size: 17px; margin-bottom: 12px; color: var(--dark); }
    .step p { font-size: 15px; color: var(--olive); line-height: 1.7; }

    .why-section-sub { font-family: 'Lora', serif; font-size: 19px; color: var(--olive); max-width: 680px; line-height: 1.85; margin-bottom: 12px; }
    .why-tagline { font-family: 'Archivo', sans-serif; font-size: 15px; color: var(--accent); letter-spacing: 0.04em; font-style: italic; margin-bottom: 0; }
    .why-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; margin-top: 48px; }
    .why-card { padding: 32px; border-radius: 4px; background: var(--white); border: 1px solid rgba(209,176,153,0.25); display: flex; gap: 20px; align-items: flex-start; }
    .why-icon { width: 48px; height: 48px; flex-shrink: 0; background: rgba(189,63,63,0.09); border-radius: 2px; display: flex; align-items: center; justify-content: center; font-size: 22px; }
    .why-card h3 { font-family: 'Archivo Black', sans-serif; font-size: 17px; margin-bottom: 8px; }
    .why-card p { font-size: 15px; color: var(--olive); line-height: 1.7; }

    .cta-banner { background: var(--red); padding: 80px 8%; text-align: center; position: relative; overflow: hidden; }
    .cta-banner::before { content: ''; position: absolute; top: -60px; left: -60px; width: 300px; height: 300px; background: rgba(255,255,255,0.05); border-radius: 50%; }
    .cta-banner h2 { font-family: 'Archivo Black', sans-serif; font-size: clamp(28px, 3vw, 44px); color: var(--white); margin-bottom: 16px; }
    .cta-banner p { font-family: 'Lora', serif; font-size: 18px; color: rgba(255,255,255,0.8); margin-bottom: 36px; }
    .btn-white { background: var(--white); color: var(--red); }
    .btn-white:hover { background: var(--bg); transform: translateY(-2px); }

    .about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center; }
    .about-img { aspect-ratio: 4/3; background: #f8f3f0; border-radius: 4px; border: none; display: flex; align-items: center; justify-content: center; font-size: 80px; }
    .about-text .section-sub { max-width: 100%; margin-top: 20px; }
    .about-quote { margin: 32px 0; padding: 24px 28px; border-left: 3px solid var(--red); background: rgba(189,63,63,0.04); font-family: 'Lora', serif; font-size: 18px; color: var(--dark); line-height: 1.7; font-style: italic; }

    .leistungen-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; margin-top: 56px; }
    .leistung-card { padding: 36px 28px; background: var(--white); border: 1px solid rgba(209,176,153,0.3); border-radius: 4px; transition: box-shadow 0.2s, transform 0.2s; }
    .leistung-card:hover { box-shadow: 0 8px 32px rgba(44,49,45,0.08); transform: translateY(-3px); }
    .leistung-icon { font-size: 36px; margin-bottom: 20px; }
    .leistung-card h3 { font-family: 'Archivo Black', sans-serif; font-size: 19px; margin-bottom: 12px; }
    .leistung-card p { font-size: 15px; color: var(--olive); line-height: 1.7; }
    .leistung-card .price { margin-top: 24px; padding-top: 20px; border-top: 1px solid rgba(209,176,153,0.3); font-size: 14px; color: var(--olive); font-style: italic; }

    .kontakt-grid { display: grid; grid-template-columns: 1fr 1.4fr; gap: 80px; align-items: start; }
    .kontakt-info h3 { font-family: 'Archivo Black', sans-serif; font-size: 20px; margin-bottom: 24px; }
    .kontakt-detail { display: flex; align-items: flex-start; gap: 14px; margin-bottom: 20px; }
    .kontakt-detail-icon { width: 40px; height: 40px; flex-shrink: 0; background: rgba(189,63,63,0.09); border-radius: 2px; display: flex; align-items: center; justify-content: center; font-size: 18px; }
    .kontakt-detail-text { font-size: 15px; color: var(--olive); }
    .kontakt-detail-text strong { display: block; color: var(--dark); font-size: 14px; font-weight: 500; letter-spacing: 0.04em; text-transform: uppercase; margin-bottom: 2px; }
    .kontakt-detail-text a { color: var(--olive); text-decoration: none; }
    .kontakt-detail-text a:hover { color: var(--red); }

    .form-group { margin-bottom: 20px; }
    .form-group label { display: block; font-size: 12px; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; color: var(--olive); margin-bottom: 8px; }
    .form-group input, .form-group textarea { width: 100%; padding: 14px 16px; background: var(--white); border: 1.5px solid rgba(209,176,153,0.4); border-radius: 2px; font-family: 'Archivo', sans-serif; font-size: 15px; color: var(--dark); transition: border-color 0.2s; outline: none; }
    .form-group input:focus, .form-group textarea:focus { border-color: var(--red); }
    .form-group textarea { resize: vertical; min-height: 130px; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    .form-success { display: none; padding: 16px; background: rgba(189,63,63,0.08); border-radius: 2px; color: var(--red); font-size: 15px; margin-top: 16px; text-align: center; }

    footer { background: var(--dark); padding: 48px 8%; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 20px; }
    .footer-logo { display: flex; align-items: center; gap: 10px; background: transparent; }
    .footer-logo-emoji { font-size: 24px; }
    .footer-logo-text { font-family: 'Archivo Black', sans-serif; font-size: 18px; color: rgba(248,242,241,0.8); }
    footer p { font-size: 13px; color: rgba(248,242,241,0.4); }
    .footer-links { display: flex; gap: 24px; }
    .footer-links a { font-size: 13px; color: rgba(248,242,241,0.5); text-decoration: none; cursor: pointer; }
    .footer-links a:hover { color: rgba(248,242,241,0.9); }

    .fade-in { opacity: 0; transform: translateY(20px); transition: opacity 0.6s, transform 0.6s; }
    .fade-in.visible { opacity: 1; transform: translateY(0); }

    .hamburger { display: none; flex-direction: column; gap: 5px; cursor: pointer; padding: 8px; background: none; border: none; }
    .hamburger span { display: block; width: 24px; height: 2px; background: var(--dark); border-radius: 2px; transition: all 0.3s; }

    @media (max-width: 768px) {
      .hero { grid-template-columns: 1fr; padding: 48px 6%; }
      .hero-visual { display: none; }
      .steps, .leistungen-grid { grid-template-columns: 1fr; }
      .why-grid, .kontakt-grid { grid-template-columns: 1fr; }
      .about-grid { grid-template-columns: 1fr !important; }
      .about-img { width: 100%; max-width: 100%; }
      .about-img img { width: 80% !important; }

      .hamburger { display: flex; }
      .nav-links {
        display: none;
        flex-direction: column;
        position: absolute;
        top: 100px;
        left: 0; right: 0;
        background: var(--bg);
        border-bottom: 1px solid rgba(209,176,153,0.35);
        padding: 16px 6% 24px;
        gap: 0;
        list-style: none;
        z-index: 99;
      }
      .nav-links.open { display: flex; }
      .nav-links li { width: 100%; }
      .nav-links a {
        display: block;
        padding: 14px 0;
        border-bottom: 1px solid rgba(209,176,153,0.2);
        font-size: 15px;
        text-transform: none;
        letter-spacing: 0;
      }
      .nav-links li:last-child a { border-bottom: none; }
      .nav-cta { background: none !important; color: var(--red) !important; padding: 14px 0 !important; border-radius: 0; }
    }
  </style>
</head>
